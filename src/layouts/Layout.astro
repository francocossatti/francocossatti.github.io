---
import '../styles/global.css';
import up from '../assets/up.svg?raw';
import '@fontsource/urbanist/400.css';
import '@fontsource/urbanist/700.css';
import '@fontsource/open-sans/400.css';
import '@fontsource/open-sans/700.css';
---
<!doctype html>
<html lang="es" class="scroll-smooth h-full overflow-y-scroll snap-y snap-mandatory">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	  <body class="bg-[#1A1918] relative w-screen h-screen overflow-y-scroll snap-y snap-mandatory m-0">
		<div class="fixed w-[clamp(3.5rem,8.5vw,5rem)] flex items-center justify-center drop-shadow-lg aspect-square bg-[#21201F] bottom-[16px] right-[16px] rounded-full"><div class="contenedor-icono" set:html={up} /></div>
		<slot/>
		</body>
</html>
