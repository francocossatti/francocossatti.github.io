---
import Laptop from '../assets/laptop.svg';
import Smartphone from '../assets/smartphone.svg';
import LogoSolidJS from '../assets/logo-solidjs.svg';
import LogoTailwind from '../assets/logo-tailwind.svg';
import LogoMotion from '../assets/logo-motion.svg';
import Test from './Test.astro';
import ProjectButton from './ProjectButton.astro';
import { Image } from 'astro:assets';

const Proyectos = [{Laptop: Laptop, Smartphone: Smartphone}]

---

<div id="projects" class="w-full flex relative flex-col justify-center p-4 gap-16 lg:gap-0">
    <div class="absolute w-[clamp(6rem,15vw,16rem)] aspect-square bg-[#FFF0DB] rounded-full blur-3xl left-[clamp(1rem,20vw,16rem)] top-[clamp(6rem,15vh,16rem)]"></div>
    <div class="absolute w-[clamp(6rem,15vw,16rem)] aspect-square bg-[#FFF0DB] rounded-full blur-3xl right-[clamp(1rem,40vw,16rem)] top-[clamp(1rem,50vh,35rem)]"></div>

    <div class="w-full z-20 flex flex-col lg:flex-row lg:items-center lg:justify-evenly gap-4">

        <div class="w-full lg:w-[32rem] lg:shrink-0 flex flex-col gap-4">
            <h1 class="w-full uppercase text-[3.625rem] lg:text-[5.5rem] text-center lg:text-left font-urbanist text-[#D3CFCA] leading-[0.95]">Mis <br class="lg:hidden"><span class="text-[#FFF0DB] font-extrabold"> Proyectos</span></h1>

            <div class="flex w-full gap-4 justify-center lg:justify-start">
                <ProjectButton svg={Laptop.src} isDisabled={true} texto="Laptop"/>
                <ProjectButton svg={Smartphone.src} isDisabled={false} texto="Smartphone"/>
            </div>

            <div class="flex flex-col gap-5">
                <div class="flex gap-4">
                    <div class="text-[12px] lg:text-[14px] flex gap-2 justify-center text-center drop-shadow-lg font-open-sans text-[#D3CFCA] w-1/3 rounded-full bg-[#21201F] p-2 lg:py-3"><LogoSolidJS/> SolidJS</div>
                    <div class="text-[12px] lg:text-[14px] flex gap-2 justify-center text-center drop-shadow-lg font-open-sans text-[#D3CFCA] w-1/3 rounded-full bg-[#21201F] p-2 lg:py-3"><LogoTailwind/>Tailwind</div>
                    <div class="text-[12px] lg:text-[14px] flex gap-2 justify-center text-center drop-shadow-lg font-open-sans text-[#D3CFCA] w-1/3 rounded-full bg-[#21201F] p-2 lg:py-3"><LogoMotion/>Motion</div>
                </div>
                <div class="text-[#D3CFCA] drop-shadow-lg text-[15px] lg:text-[18px] font-open-sans bg-[#21201F] p-4 lg:p-6 rounded-2xl lg:leading-relaxed">Pequeño diseño para una <span class="text-[#FFF0DB] font-bold">agencia de transporte interdepartamental</span> en el departamento de Colonia.</div>
            </div>
        </div>
        <div class="flex h-[clamp(15rem,30vw,25rem)] [&_img]:w-full self-center">
            <Test/>
        </div>
    </div>
</div>

<script>
    const buttons = document.getElementsByName('projectButton');
    const svgContainer = document.getElementsByClassName('svg-container')[0]
    let selectedButton = buttons[0];
    buttons.forEach((button) => {
        button.addEventListener('click', function() {
            selectedButton.removeAttribute('disabled')
            button.setAttribute('disabled', '')
            svgContainer!.setAttribute('srcset', button.getAttribute('value')!)
            selectedButton = button;
        })
    })
</script>