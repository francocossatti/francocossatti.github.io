---
import { getImage } from 'astro:assets';
import mail from '../assets/mail.svg?raw';
import aboutme from '../assets/about-me.svg?raw';
import projects from '../assets/projects.svg?raw';
import code from '../assets/code.svg?raw';
import fotoFondo from '../assets/nueva-palmira.jpeg';
const optimizedBackground = await getImage({
  src: fotoFondo,
  format: 'webp',
  quality: 80,
});
---

<div class="w-full h-screen relative flex flex-col justify-center bg-center bg-fixed bg-cover" style={`background-image: url(${optimizedBackground.src});`}>
  <div class="bg-[#0F0F0F] opacity-80 absolute inset-0"/>
  <div class="flex flex-col gap-24 text-[#D3CFCA] m-4 relative z-20">
    <div class="font-urbanist uppercase">
      <h1 class="font-extrabold text-transparent bg-center bg-cover bg-fixed bg-clip-text  text-[4.4rem]" style={`background-image: url(${optimizedBackground.src});`}>Franco Cossatti</h1>
      <h2 class="text-right text-[1.06rem]">Desarrollador <span class="text-[#FFF0DB] font-bold">Digital</span></h2>
    </div>
    <div class="flex flex-col gap-32 font-open-sans uppercase text-center">
      <p class="text-[1.25rem]">Resuelvo problemas digitales <br> mediante desarrollo <br> y análisis desde <span class="text-[#FFF0DB] font-bold">Nueva Palmira</span></p>
      <div class="text-[0.6rem] bg-[#21201F]/65 border border-solid border-[#D3CFCA] rounded-full flex p-4 gap-4 uppercase justify-center mt-4">
        <button class="flex flex-col items-center"><div set:html={aboutme} />Sobre mi</button>
        <button class="flex flex-col items-center"><div set:html={code} />Habilidades</button>
        <button class="flex flex-col items-center"><div set:html={projects} />Proyectos</button>
        <button class="flex flex-col items-center"><div set:html={mail} />Contacto</button>
      </div>
    </div>
  </div>
</div>