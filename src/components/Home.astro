---
import { getImage } from 'astro:assets';
import mail from '../assets/mail.svg?raw';
import aboutme from '../assets/about-me.svg?raw';
import projects from '../assets/projects.svg?raw';
import code from '../assets/code.svg?raw';
import fotoFondo from '../assets/nueva-palmira.jpeg';
const optimizedBackground = await getImage({
  src: fotoFondo,
  format: 'webp',
  quality: 80,
});
---

<div id="home" class="w-full relative flex flex-col justify-center bg-center bg-fixed bg-cover" style={`background-image: url(${optimizedBackground.src});`}>
  <div class="bg-[#0F0F0F] opacity-80 absolute inset-0"/>
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-24 md:gap-8 text-[#D3CFCA] m-4 md:mx-16 relative z-20">
    <div class="flex flex-col gap-24 md:gap-16">
      <div class="w-fit font-urbanist uppercase">
        <h1 class="font-extrabold text-transparent w-min xl:text-nowrap bg-center bg-cover bg-fixed bg-clip-text text-[4.4rem] md:text-[6.5rem] md:leading-none" style={`background-image: url(${optimizedBackground.src});`}>Franco <br class="md:hidden">Cossatti</h1>
        <h2 class="text-right text-[1.06rem] md:text-[1.3rem]">Desarrollador <span class="text-[#FFF0DB] font-bold">Digital</span></h2>
      </div>
      <p class="font-open-sans uppercase text-center md:text-left text-[1.25rem] md:text-[1.5rem] md:max-w-md">
        Resuelvo problemas digitales <br class="md:hidden" /> mediante desarrollo <br class="md:hidden" /> y análisis desde <span class="text-[#FFF0DB] font-bold">Nueva Palmira</span>
      </p>
    </div>
    <div class="text-[0.6rem] md:text-[0.75rem] bg-[#21201F]/65 border border-solid border-[#D3CFCA] rounded-full flex md:flex-col p-4 md:py-8 md:px-3 gap-4 md:gap-10 font-open-sans uppercase justify-center items-center">
      <a href="#about" class="flex flex-col items-center gap-1"><div set:html={aboutme} />Sobre mi</a>
      <a href="#skills" class="flex flex-col items-center gap-1"><div set:html={code} />Habilidades</a>
      <a href="#projects" class="flex flex-col items-center gap-1"><div set:html={projects} />Proyectos</a>
      <a href="#contact" class="flex flex-col items-center gap-1"><div set:html={mail} />Contacto</a>
    </div>
  </div>
</div>