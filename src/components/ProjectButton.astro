---
const { svg, isDisabled, texto } =  Astro.props;
---

<button name="projectButton" value={svg} class="disabled:bg-[#D3CFCA] disabled:text-[#21201F] text-[14px] md:text-[16px] drop-shadow-lg font-open-sans text-[#D3CFCA] w-hug p-4 md:w-fit md:px-8 md:py-3 rounded-full bg-[#21201F] p-2" disabled={isDisabled}>{texto}</button>